---
import StoreLayout from '../layouts/StoreLayout.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../content/site';
---
<StoreLayout title={`${site.notFound.pageTitle} — ${site.name}`} noindex={true}>
  <section class="not-found container"><p class="eyebrow">{site.notFound.eyebrow}</p><h1 class="multiline">{site.notFound.title}</h1><p>{site.notFound.description}</p><a class="button" href="/">{site.notFound.cta}<Arrow /></a></section>
</StoreLayout>
