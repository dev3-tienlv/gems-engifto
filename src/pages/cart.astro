---
import StoreLayout from '../layouts/StoreLayout.astro';
import Icon from '../components/Icon.astro';
import Arrow from '../components/Arrow.astro';
---
<StoreLayout title="Your cart — Engifto" noindex>
  <section class="page-heading container"><p class="eyebrow">Thoughtful choices, all together</p><h1>Your <em>cart.</em></h1><p>A little closer to a more considered workspace.</p></section>
  <section class="container cart-section" aria-label="Shopping cart">
    <div class="empty-state" data-cart-empty><Icon name="bag" /><h2>Your cart is a blank canvas.</h2><p>Start with a small detail. See where it takes you.</p><a class="button" href="/shop">Explore the collection<Arrow /></a></div>
    <div class="commerce-grid" data-cart-content hidden>
      <div><div class="cart-table-heading"><span>Your essentials</span><span>Item total</span></div><div data-cart-lines></div><a class="text-link" href="/shop">Continue exploring<Arrow diagonal /></a></div>
      <aside class="order-summary"><p class="eyebrow">The little details</p><h2>Cart summary</h2><div class="shipping-progress"><p data-shipping-progress></p><progress data-shipping-meter max="10000" value="0" aria-label="Progress toward free standard shipping"></progress></div><dl class="totals"><div><dt>Subtotal</dt><dd data-cart-subtotal></dd></div><div><dt>Standard shipping estimate</dt><dd data-cart-shipping></dd></div><div class="total-row"><dt>Total</dt><dd data-cart-total></dd></div></dl><a class="button full-width" href="/checkout">Continue to checkout<Arrow /></a><p class="summary-note">All prices in USD. Shipping calculated at checkout.</p></aside>
    </div>
  </section>
</StoreLayout>
<script>import { initCart } from '../scripts/cart-page'; initCart();</script>
