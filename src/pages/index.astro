---
import StoreLayout from '../layouts/StoreLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import { site } from '../content/site';
import { categories, products } from '../content/catalog';
---
<StoreLayout>
  <section class="hero store-hero container" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow"><span class="tiny-mark" aria-hidden="true"></span>{site.hero.eyebrow}</p><h1 id="hero-title">{site.hero.lines.map((line, i) => <span class:list={{ 'accent-text': i === 2 }}>{line}</span>)}</h1><p class="hero-description">{site.hero.description}</p><div class="hero-actions"><a class="button" href="/shop">{site.hero.primary}<Arrow /></a><a class="text-link" href="/about">{site.hero.secondary}<Arrow diagonal /></a></div><div class="hero-note"><span class="status-dot" aria-hidden="true"></span><span>{products.length} considered essentials</span><span class="note-divider" aria-hidden="true">/</span><span>A space that feels like you.</span></div></div>
    <figure class="hero-photo"><img src={site.hero.image} alt={site.hero.alt} width="1500" height="864" fetchpriority="high" /><span class="photo-index">THE WORKSPACE EDIT / 01</span><figcaption>{site.hero.caption}</figcaption></figure>
  </section>
  <div class="store-benefits container"><span><Icon name="leaf" />A considered collection</span><span><Icon name="package" />Simple, everyday essentials</span><span><Icon name="check" />A calmer kind of workspace</span></div>
  <section id="collections" class="store-section container" aria-labelledby="collections-title"><div class="section-heading"><div><p class="eyebrow">Find your everyday essentials</p><h2 id="collections-title">Little things. <em>Better spaces.</em></h2></div><a class="text-link" href="/shop">Shop all essentials<Arrow diagonal /></a></div><div class="collection-grid">{categories.map(category => <a href={`/shop?category=${category.id}`} class="collection-card"><div><img src={category.image} alt={`${category.name} collection`} width="1000" height="667" loading="lazy" /></div><span><h3>{category.name}</h3><Arrow diagonal /></span><p>{category.description}</p></a>)}</div></section>
  <section class="store-section featured-section" aria-labelledby="featured-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">The everyday edit</p><h2 id="featured-title">Useful things, <em>thoughtfully chosen.</em></h2></div><a href="/shop" class="text-link">Explore the collection<Arrow diagonal /></a></div><div class="product-grid">{products.filter(product => product.featured).map(product => <ProductCard product={product} />)}</div></div></section>
  <section class="store-section story-section container" aria-labelledby="story-title"><img src="/images/story.webp" alt="An uncluttered white desk with a lamp, notebook, and pencil cup" width="1500" height="1000" loading="lazy" /><div><p class="eyebrow">A little intention goes a long way</p><h2 id="story-title">Make the everyday<br /><em>feel a little better.</em></h2><p>Good work starts with a space that makes room for it. A notebook for the next idea. A little light for a late afternoon. Something green in the corner.</p><p>Engifto brings these small details together in a collection for a more considered workday.</p><a href="/about" class="text-link">The story behind Engifto<Arrow diagonal /></a></div></section>
  <section class="store-section container" aria-labelledby="new-title"><div class="section-heading"><div><p class="eyebrow">A fresh perspective</p><h2 id="new-title">New to <em>the collection.</em></h2></div><a href="/shop?sort=newest" class="text-link">See what’s new<Arrow diagonal /></a></div><div class="product-grid new-grid">{products.filter(product => product.badge === 'New').slice(0, 3).map(product => <ProductCard product={product} />)}</div></section>
  <section id="faq" class="faq-section store-section container" aria-labelledby="faq-title"><div><p class="eyebrow">A little more context</p><h2 id="faq-title">Good questions.<br /><em>Clear answers.</em></h2><a href="/contact" class="text-link">Help & contact<Arrow diagonal /></a></div><div class="faq-list">{site.faq.items.map(item => <details><summary>{item.question}<span class="faq-icon" aria-hidden="true"></span></summary><p>{item.answer}</p></details>)}</div></section>
  <section class="closing-section store-closing"><div class="container"><p class="eyebrow">Your next good idea starts here</p><h2>A little more space.<br /><em>A little more possibility.</em></h2><p>Find the small details that make your workspace your own.</p><a href="/shop" class="button">Find your everyday essentials<Arrow diagonal /></a></div></section>
</StoreLayout>
