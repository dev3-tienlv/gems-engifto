---
import StoreLayout from '../layouts/StoreLayout.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../content/site';
import { categories } from '../content/catalog';
---
<StoreLayout>
  <section class="hero store-hero company-hero container" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow"><span class="tiny-mark" aria-hidden="true"></span>{site.hero.eyebrow}</p><h1 id="hero-title">{site.hero.lines.map((line, i) => <span class:list={{ 'accent-text': i === 2 }}>{line}</span>)}</h1><p class="hero-description">{site.hero.description}</p><div class="hero-actions"><a class="button" href="/about">{site.hero.primary}<Arrow /></a><a class="text-link" href="/approach">{site.hero.secondary}<Arrow diagonal /></a></div><div class="hero-note"><span class="status-dot" aria-hidden="true"></span><span>Workspace commerce</span><span class="note-divider" aria-hidden="true">/</span><span>Built around everyday life</span></div></div>
    <figure class="hero-photo"><img src={site.hero.image} alt={site.hero.alt} width="1500" height="864" fetchpriority="high" /><span class="photo-index">OUR STARTING POINT / THE PERSONAL WORKSPACE</span><figcaption>{site.hero.caption}</figcaption></figure>
  </section>
  <section class="company-intro purpose-section container" aria-labelledby="purpose-title"><div class="purpose-visual"><p class="eyebrow">Our purpose</p><img class="purpose-photo" src="/images/purpose-workspace.webp" alt="A wooden workspace with a desktop computer, stationery, and plants beside a sunlit window" width="827" height="551" loading="lazy" decoding="async" /></div><div><h2 id="purpose-title">Good work deserves<br /><em>a thoughtful space.</em></h2><p>The way we work has become more personal. Our desks are places to focus, learn, and make things. Finding the right everyday objects for those spaces should feel just as considered.</p><p>{site.business.purpose}</p></div></section>
  <section class="store-section featured-section" aria-labelledby="business-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">The business at a glance</p><h2 id="business-title">A clear focus.<br /><em>A useful starting point.</em></h2></div><a class="text-link" href="/about">About the company<Arrow diagonal /></a></div><div class="company-pillars"><article><span class="eyebrow">01 / Our business</span><h3>Workspace commerce.</h3><p>A direct-to-consumer retail business in development, connecting a focused product collection with a clear online discovery experience.</p></article><article><span class="eyebrow">02 / Our audience</span><h3>Everyday creators.</h3><p>People working from home, students shaping a study space, and independent creatives making room for their next idea.</p></article><article><span class="eyebrow">03 / Our product</span><h3>Discovery, simplified.</h3><p>Useful categories, readable product details, and a consistent path from exploring the collection to bringing selections together.</p></article></div></div></section>
  <section class="store-section story-section container" aria-labelledby="experience-title"><img src="/images/story.webp" alt="A white workspace with a desk lamp, notebook, and pencil cup" width="1500" height="1000" loading="lazy" /><div><p class="eyebrow">What we’re building</p><h2 id="experience-title">Thoughtful products.<br /><em>A connected experience.</em></h2><p>Engifto brings the collection and the digital experience together. Our starting point is paper goods, desk lighting, and workspace accessories — everyday objects with a clear place in someone’s routine.</p><p>We are developing the browsing experience alongside the business: how products are presented, how people find them, and how the details stay clear.</p><a href="/approach" class="text-link">See how we approach it<Arrow diagonal /></a></div></section>
  <section class="store-section company-process container" aria-labelledby="approach-title"><div class="section-heading"><div><p class="eyebrow">How we think</p><h2 id="approach-title">Less noise.<br /><em>More intention.</em></h2></div><a class="text-link" href="/approach">Our approach<Arrow diagonal /></a></div><ol class="company-steps">{site.approach.map(step => <li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div><Arrow diagonal /></li>)}</ol></section>
  <section class="store-section featured-section" aria-labelledby="collection-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">The collection behind the idea</p><h2 id="collection-title">Our focus, <em>made tangible.</em></h2></div><a class="text-link" href="/shop">Explore the collection<Arrow diagonal /></a></div><div class="collection-grid">{categories.map(category => <a href={`/shop?category=${category.id}`} class="collection-card"><div><img src={category.image} alt={`${category.name} collection`} width="1000" height="667" loading="lazy" /></div><span><h3>{category.name}</h3><Arrow diagonal /></span><p>{category.description}</p></a>)}</div></div></section>
  <section id="faq" class="faq-section store-section container" aria-labelledby="faq-title"><div><p class="eyebrow">About the business</p><h2 id="faq-title">A little context.<br /><em>A clearer picture.</em></h2><a href="/contact" class="text-link">Company information<Arrow diagonal /></a></div><div class="faq-list">{site.faq.items.map(item => <details><summary>{item.question}<span class="faq-icon" aria-hidden="true"></span></summary><p>{item.answer}</p></details>)}</div></section>
  <section class="closing-section store-closing"><div class="container"><p class="eyebrow">Get to know Engifto</p><h2>A considered business.<br /><em>An everyday purpose.</em></h2><p>Learn more about the company we’re building and the thinking behind it.</p><a href="/about" class="button">More about Engifto<Arrow diagonal /></a></div></section>
</StoreLayout>
