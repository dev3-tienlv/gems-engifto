---
import StoreLayout from '../layouts/StoreLayout.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../content/site';
---
<StoreLayout title="Our approach — Engifto" description="How Engifto approaches workspace commerce: a focused collection, simpler product discovery, and a consistent digital experience.">
  <section class="page-heading container"><p class="eyebrow">How we’re building Engifto</p><h1>Start with a need.<br /><em>Build with intention.</em></h1><p>A personal workspace is our starting point. A useful collection and a clear digital experience are how we bring that idea to life.</p></section>
  <section class="company-intro container" aria-labelledby="challenge-title"><p class="eyebrow">The opportunity</p><div><h2 id="challenge-title">Finding the right things<br /><em>should feel simpler.</em></h2><p>Building a workspace often means comparing scattered products across different categories. Engifto’s direction is to bring those everyday needs into one focused experience.</p><p>We begin with a specific audience and three complementary categories, rather than a collection that tries to be everything to everyone.</p></div></section>
  <section class="store-section featured-section"><div class="container"><p class="eyebrow">Our approach</p><ol class="company-steps">{site.approach.map(step => <li><span>{step.number}</span><div><h2>{step.title}</h2><p>{step.description}</p></div></li>)}</ol></div></section>
  <section class="business-section approach-delivery container" aria-labelledby="experience-title"><div><p class="eyebrow">The experience today</p><h2 id="experience-title">From a clear idea<br /><em>to something useful.</em></h2><p>The collection makes our approach tangible. Explore categories, compare product details, and discover how different pieces fit into a personal workspace.</p><a href="/shop" class="text-link">Explore the collection<Arrow diagonal /></a></div><dl><div><dt>Discovery</dt><dd>Category filters, product search, and sorting for a focused browsing experience.</dd></div><div><dt>Product information</dt><dd>Readable descriptions, details, and photography presented consistently across the collection.</dd></div><div><dt>Exploration</dt><dd>Individual product pages and related pieces that connect the collection across everyday needs.</dd></div><div><dt>Next foundations</dt><dd>Confirming business contact information, fulfillment arrangements, and commercial operations.</dd></div></dl></section>
  <section class="closing-section store-closing"><div class="container"><p class="eyebrow">The company behind the experience</p><h2>A small everyday need.<br /><em>A focused direction.</em></h2><p>Learn more about who we’re building for and why.</p><a class="button" href="/about">About Engifto<Arrow /></a></div></section>
</StoreLayout>
