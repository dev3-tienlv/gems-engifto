---
import StoreLayout from '../layouts/StoreLayout.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../content/site';
---
<StoreLayout title="Company — Engifto" description="Meet Engifto: our purpose, workspace commerce business, intended audience, and the experience we are building.">
  <section class="page-heading container"><p class="eyebrow">About the company</p><h1>A clear purpose.<br /><em>A thoughtful business.</em></h1><p>{site.business.description}</p></section>
  <section class="about-store container"><img src="/images/story.webp" alt="A white desk with a notebook, lamp, and stationery in soft window light" width="1500" height="1000" fetchpriority="high" /><div class="prose"><h2>Built around the everyday workspace.</h2><p>Work, study, and creative projects increasingly share the same spaces. The everyday objects in those spaces need to be useful, personal, and easy to bring together.</p><p>Engifto starts with this specific need. We are developing a focused collection of paper goods, desk lighting, and workspace accessories, supported by a straightforward online experience.</p><h2>Our intended business model.</h2><p>Our direction is direct-to-consumer online retail. We aim to help people discover and compare workspace essentials in one place, with a consistent presentation across categories.</p><p>The collection experience is available to explore today. Commercial operations, fulfillment arrangements, and published business contact details are still being developed.</p><a class="text-link" href="/approach">The thinking behind Engifto<Arrow diagonal /></a></div></section>
  <section class="container values-section" aria-label="Company principles"><div><span>01 / Purpose</span><h2>Useful by nature.</h2><p>Focus on everyday needs and objects with a clear role in someone’s workspace.</p></div><div><span>02 / Experience</span><h2>Simple by design.</h2><p>Make discovery easier through a focused collection and clear product information.</p></div><div><span>03 / Development</span><h2>Considered in practice.</h2><p>Build the product experience and operational foundations together, with details published as they are confirmed.</p></div></section>
  <section class="business-section container" aria-labelledby="building-title"><div><p class="eyebrow">Company overview</p><h2 id="building-title">A focused business.<br /><em>A simpler experience.</em></h2><p>{site.business.building}</p><a href="/contact" class="text-link">Company information<Arrow diagonal /></a></div><dl><div><dt>Business direction</dt><dd>Direct-to-consumer workspace commerce.</dd></div><div><dt>Made for</dt><dd>{site.business.audience}</dd></div><div><dt>Product focus</dt><dd>Paper & writing, desk lighting, and desk accents.</dd></div><div><dt>Our purpose</dt><dd>{site.business.purpose}</dd></div>{site.contactEmail && <div><dt>Get in touch</dt><dd><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></dd></div>}</dl></section>
</StoreLayout>
