---
import StoreLayout from '../layouts/StoreLayout.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../content/site';
---
<StoreLayout title="Help & contact — Engifto" description="Find answers about the Engifto collection, your shopping cart, checkout, and photography.">
  <section class="page-heading container"><p class="eyebrow">A little help along the way</p><h1>Good questions.<br /><em>Clear answers.</em></h1><p>Everything you need to know about exploring Engifto.</p></section>
  <section class="help-grid container"><div class="faq-list">{site.faq.items.map(item => <details><summary>{item.question}<span class="faq-icon" aria-hidden="true"></span></summary><p>{item.answer}</p></details>)}<details><summary>Can I change or empty my cart?<span class="faq-icon" aria-hidden="true"></span></summary><p>Open your cart to adjust quantities or remove items. Each product is limited to 10. Your cart stays on this browser until you remove items or complete checkout.</p></details><details><summary>Which currency is shown?<span class="faq-icon" aria-hidden="true"></span></summary><p>All prices are in US dollars (USD). Choose a shipping option at checkout to see your total.</p></details></div><aside class="help-card"><p class="eyebrow">A little more context</p><h2>Here for<br /><em>the details.</em></h2><p>Explore the information below for help with your cart, shipping options, and privacy.</p>{site.contactEmail ? <a class="text-link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}<Arrow diagonal /></a> : <p class="small-note">A verified support contact has not been published yet. Please see the information below.</p>}<a class="text-link" href="/policies/shipping">Shipping information<Arrow diagonal /></a><a class="text-link" href="/policies/returns">Returns information<Arrow diagonal /></a><a class="text-link" href="/policies/privacy">Privacy policy<Arrow diagonal /></a></aside></section>
</StoreLayout>
