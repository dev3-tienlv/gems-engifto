---
import StoreLayout from '../layouts/StoreLayout.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../content/site';
---
<StoreLayout title="Contact & company information — Engifto" description="Learn about Engifto’s business direction, audience, collection experience, and published contact information.">
  <section class="page-heading container"><p class="eyebrow">Contact & company information</p><h1>Get to know<br /><em>the business.</em></h1><p>Company context, our current focus, and where to find more information about Engifto.</p></section>
  <section class="help-grid container"><div><p class="eyebrow">Frequently asked questions</p><div class="faq-list">{site.faq.items.map(item => <details><summary>{item.question}<span class="faq-icon" aria-hidden="true"></span></summary><p>{item.answer}</p></details>)}</div></div><aside class="help-card"><p class="eyebrow">Business inquiries</p><h2>A shared interest<br /><em>in better spaces.</em></h2><p>Our focus brings together workspace products and a considered online experience. Learn about the company and the approach behind the collection.</p>{site.contactEmail ? <a class="text-link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}<Arrow diagonal /></a> : <p class="small-note">Business contact details will be published here once confirmed.</p>}<a class="text-link" href="/about">Company overview<Arrow diagonal /></a><a class="text-link" href="/approach">Our approach<Arrow diagonal /></a><a class="text-link" href="/policies/privacy">Privacy & information<Arrow diagonal /></a></aside></section>
</StoreLayout>
