---
import StoreLayout from '../layouts/StoreLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { products, categories } from '../content/catalog';
---
<StoreLayout title="Shop the collection — Engifto" description="Explore the Engifto collection of paper goods, desk lighting, and workspace accents.">
  <section class="page-heading container"><p class="eyebrow">The Engifto collection</p><h1>Good things for<br /><em>your everyday.</em></h1><p>Paper, light, and the little details that make room for better work.</p></section>
  <section class="shop-section container" aria-label="Product catalog">
    <form class="shop-tools" data-shop-filters role="search"><div class="search-field"><Icon name="search" /><label class="sr-only" for="search">Search products</label><input type="search" id="search" name="q" placeholder="Find your next essential…" maxlength="100" autocomplete="off" /></div><div class="sort-field"><label for="sort">Sort by</label><select id="sort" name="sort"><option value="featured">Featured</option><option value="price-asc">Price: low to high</option><option value="price-desc">Price: high to low</option><option value="name">Name: A to Z</option><option value="newest">New arrivals</option></select></div></form>
    <div class="shop-category-row"><div class="category-filters" role="group" aria-label="Product category"><button class="category-filter is-active" data-filter="all" aria-pressed="true">All essentials</button>{categories.map(category => <button class="category-filter" data-filter={category.id} aria-pressed="false">{category.name}</button>)}</div><p data-results-count role="status">{products.length} essentials</p></div>
    <div class="product-grid" data-shop-grid>{products.map(product => <ProductCard product={product} />)}</div>
    <div class="empty-state" data-no-results hidden><Icon name="search" /><h2>No essentials found.</h2><p>Try another word or explore the whole collection.</p><button class="button" data-reset-filters>Clear filters</button></div>
  </section>
</StoreLayout>
<script>
  import { initShop } from '../scripts/shop';
  initShop();
</script>
