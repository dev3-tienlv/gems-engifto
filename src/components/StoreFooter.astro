---
import { site } from '../content/site';
import { categories } from '../content/catalog';
---
<footer class="store-footer container">
  <div class="store-footer-grid"><div><a href="/" class="wordmark" aria-label={site.labels.home}>engifto<span class="brand-dot">.</span></a><p>Small details for a calmer,<br />more considered workday.</p></div>
    <div><h2>Explore</h2><a href="/shop">All essentials</a>{categories.map(category => <a href={`/shop?category=${category.id}`}>{category.name}</a>)}</div>
    <div><h2>A little more</h2><a href="/about">Our story</a><a href="/contact">Help & contact</a><a href="/photography">Photography credits</a><a href="/cart">Your cart</a></div>
    <div><h2>The details</h2><a href="/policies/shipping">Shipping information</a><a href="/policies/returns">Returns information</a><a href="/policies/privacy">Privacy policy</a><a href="/policies/terms">Terms of use</a></div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><span>Thoughtful essentials. Better workdays.</span>{site.contactEmail && <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}</div>
</footer>
