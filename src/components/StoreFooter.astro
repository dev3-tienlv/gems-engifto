  <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><span>Better spaces. Thoughtfully built.</span>{site.contactEmail && <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}</div>
