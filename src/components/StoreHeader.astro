---
import Icon from './Icon.astro';
import { site } from '../content/site';
---
<div class="store-announcement"><span>{site.announcement}</span><a href="/shop">Discover something thoughtful <span aria-hidden="true">↗</span></a></div>
<header class="site-header container store-header">
  <a class="wordmark" href="/" aria-label={site.labels.home}>{site.name.toLowerCase()}<span class="brand-dot">.</span></a>
  <button class="menu-toggle" aria-label={site.labels.openMenu} aria-expanded="false" aria-controls="main-navigation" hidden><span></span><span></span></button>
  <nav class="main-nav" id="main-navigation" aria-label={site.labels.navigation}>
    <a href="/shop" aria-current={Astro.url.pathname.startsWith('/shop') ? 'page' : undefined}>Shop the collection</a>
    <a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>Our story</a>
    <a href="/contact" aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}>Help & contact</a>
  </nav>
  <div class="header-tools"><a href="/shop#search" class="icon-link" aria-label="Search products"><Icon name="search" /></a><a href="/cart" class="cart-link" aria-label="Shopping cart" data-cart-link><Icon name="bag" /><span class="cart-count" data-cart-count aria-hidden="true">0</span></a></div>
</header>
