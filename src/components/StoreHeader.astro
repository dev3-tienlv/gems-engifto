---
import Icon from './Icon.astro';
import { site } from '../content/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const commerce = path === '/shop' || path.startsWith('/products/') || ['/cart', '/checkout', '/order-confirmation'].includes(path);
const navigation = [{ href: '/about', label: 'Company' }, { href: '/approach', label: 'Our approach' }, { href: '/shop', label: 'Collection' }, { href: '/contact', label: 'Contact' }];
---
<div class="store-announcement"><span>{site.announcement}</span><a href="/about">Get to know Engifto <span aria-hidden="true">↗</span></a></div>
<header class:list={['site-header', 'container', 'store-header', { 'company-header': !commerce }]}>
  <a class="wordmark" href="/" aria-label={site.labels.home}>{site.name.toLowerCase()}<span class="brand-dot">.</span></a>
  <button class="menu-toggle" aria-label={site.labels.openMenu} aria-expanded="false" aria-controls="main-navigation" hidden><span></span><span></span></button>
  <nav class="main-nav" id="main-navigation" aria-label={site.labels.navigation}>
    {navigation.map(link => <a href={link.href} aria-current={path === link.href || (link.href === '/shop' && path.startsWith('/products/')) ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  {commerce && <div class="header-tools"><a href="/shop#search" class="icon-link" aria-label="Search products"><Icon name="search" /></a><a href="/cart" class="cart-link" aria-label="Shopping cart" data-cart-link><Icon name="bag" /><span class="cart-count" data-cart-count aria-hidden="true">0</span></a></div>}
</header>
